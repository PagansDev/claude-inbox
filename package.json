{
  "name": "claude-inbox",
  "version": "0.0.0",
  "private": true,
  "description": "One inbox for every Claude Code session",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "tauri": "tauri",
    "check": "biome check . && npm run check:comments && npm run typecheck",
    "check:comments": "git ls-files -z -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.rs' | xargs -0 node scripts/no-comments.ts",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:web": "vitest run",
    "test:scripts": "node --test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "spike": "node spike/server.ts"
  },
  "devDependencies": {
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/napi": "0.50.0",
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lint-staged": "17.6.0",
    "oxc-parser": "0.153.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "@ast-grep/lang-rust": false
  }
}
