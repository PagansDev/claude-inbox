{
  "name": "claude-inbox",
  "version": "0.0.0",
  "private": true,
  "description": "One inbox for every Claude Code session",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "check": "biome check . && npm run check:comments && npm run typecheck",
    "check:comments": "git ls-files -z -- '*.ts' '*.tsx' '*.mts' '*.cts' '*.js' '*.jsx' '*.mjs' '*.cjs' | xargs -0 node scripts/no-comments.ts",
    "fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "spike": "node spike/server.ts"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
      "node scripts/no-comments.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxc-parser": "0.153.0",
    "typescript": "7.0.2"
  }
}
